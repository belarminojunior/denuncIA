# --- Base de dados ---
# Produção/Docker: postgresql://gccc:gccc@postgres:5432/denuncia
# Desenvolvimento local sem Docker/Postgres, pode usar SQLite:
# sqlite:///./dev.db
DATABASE_URL=postgresql://gccc:gccc@localhost:5432/denuncia

# --- Segurança ---
SECRET_KEY=change-this-secret-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- LLM ---
# mock -> respostas simuladas, nao chama o Ollama (util para desenvolver o frontend)
# ollama -> chama efetivamente o Qwen3:4B-Instruct via Ollama
LLM_MODE=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=120

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_DENUNCIA=5
